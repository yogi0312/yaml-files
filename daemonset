apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nginx-daemonset

spec:
    selector:
        matchLabels:
            app: nginx-label-daemonset
    template:
        metadata:
            labels:
                app: nginx-label-daemonset
        spec:
            containers:
            - name: nginx
              image: nginx:latest
              ports:
              - containerPort: 80