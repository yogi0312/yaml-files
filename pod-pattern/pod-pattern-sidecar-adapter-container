apiVersion: v1
kind: Pod
metadata:
    name: sidecar-adapter-container-pod
    labels:
        app: test
spec:
    volumes:
    - name: shared-logs
      emptyDir: {}

    containers:
    - name: app-container
      image: nginx
      ports:
      - containerPort: 80
      volumeMounts:
      - name: shared-logs
        mountPath: /var/log/nginx

    - name: adapter-container
      image: busybox
      command: ["sh", "-c", "while true; do cat /var/log/nginx/access.log; cat /var/log/nginx/error.log; sleep 5; done"]
      volumeMounts:
      - name: shared-logs
        mountPath: /var/log/nginx