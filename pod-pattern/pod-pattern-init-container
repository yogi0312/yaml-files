apiVersion: v1
kind: Pod
metadata:
    name: init-container-pod
    labels:
        app: test
spec:
    initContainers:
    - name: init-container
      image: busybox
      command: ["/bin/sh"]
      args: ["-c", "echo '<html><h2>I am a init container</h2></html>' >> /work-dir/index.html; 
            sleep 10; 
            echo 'Init container execution completed'; "]
      volumeMounts:
      - name: empty-dir
        mountPath: "/work-dir"
    containers:
    - name: app-container
      image: nginx
      ports:
      - containerPort: 80
      volumeMounts:
      - name: empty-dir
        mountPath: "/usr/share/nginx/html"
    volumes:
    - name: empty-dir
      emptyDir: {}