apiVersion: v1
kind: ServiceAccount
metadata:
    name: service-account-readonly

---
apiVersion: v1
kind: ServiceAccount
metadata:
    name: service-account-admin

---
apiVersion: v1
kind: Secret
metadata:
    name: service-account-readonly-token
    annotations:
        kubernetes.io/service-account.name: service-account-readonly        # This annotation links the secret to the service account
type: kubernetes.io/service-account-token

---
apiVersion: v1
kind: Secret
metadata:
    name: service-account-admin-token
    annotations:
        kubernetes.io/service-account.name: service-account-admin           # This annotation links the secret to the service account
type: kubernetes.io/service-account-token

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
    name: pod-deployment-reader
rules:
- apiGroups: ["*"]                                  # "*" indicates all API groups
  resources: ["pods", "deployments"]                # Specify the resources this role can access
  verbs: ["get", "list", "watch"]                   # Specify the actions this role can perform

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
    name: role-bind-pod-deployment-reader
subjects:                                            # Subjects define who the role is assigned to
- kind: ServiceAccount
  name: service-account-readonly
roleRef:                                             # Reference to the Role
  kind: Role
  name: pod-deployment-reader
  apiGroup: rbac.authorization.k8s.io
 
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
    name: admin-all
rules:
- apiGroups: ["*"]
  resources: ["*"]
  verbs: ["*"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
    name: clusterrole-bind-admin-all
subjects:
- kind: ServiceAccount
  name: service-account-admin
  namespace: default
roleRef:                                             # Reference to the Role
  kind: ClusterRole
  name: admin-all
  apiGroup: rbac.authorization.k8s.io