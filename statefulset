apiVersion: apps/v1                 
kind:  StatefulSet                  
metadata:                          
    name: ip-app-statefulset          
spec:
    replicas: 2                       
    selector:                  
        matchLabels:            
            app: ip-app-label   
    template:                   
        metadata:               
            labels:
                app: ip-app-label
        spec:               
            containers:
            - name: ip-app-label
              image: harshajain/ip_app:2
              ports:
              - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: ip-app-headless-service
spec:
    clusterIP: None
    selector:
        app: ip-app-label
    ports:
        - port: 80
          targetPort: 80