apiVersion: apps/v1                # This is the API version for the Deployment resource in Kubernetes
kind:  Deployment                  # This specifies that we are creating a Deployment resource
metadata:                          # Metadata contains information about the Deployment, such as its name
    name: nginx-deployment          
spec:                                # The spec section defines the desired state of the Deployment
    replicas: 3                        
    selector:                  # The selector is used to identify the pods that belong to this Deployment
        matchLabels:            
            app: nginx_label    
    template:                   # The template section defines the desired state of the pods that will be created by this Deployment
        metadata:               # The metadata section of the template defines the labels that will be applied to the pods created by this Deployment
            labels:
                app: nginx_label
        spec:               # The spec section of the template defines the desired state of the containers that will be created in the pods
            containers:
            - name: nginx-container    # The name of the container is "nginx-container"
              image: nginx:latest
              ports:
              - containerPort: 80